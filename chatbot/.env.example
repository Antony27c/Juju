# Copiar este archivo como ".env" y completar. No compartir el .env con nadie.

# --- ElevenLabs (obligatorio) ---
# Clave de API: https://elevenlabs.io/app/settings/api-keys  (con permiso para "ElevenLabs Agents")
ELEVENLABS_API_KEY=
# Con la clave sola alcanza: al arrancar, el servidor busca o crea el agente en tu cuenta y lo deja al día.
# Estos ids son opcionales (los escribe "node crear-agente.mjs" si lo corrés a mano).
ELEVENLABS_AGENT_ID=
# ELEVENLABS_SINCRONIZAR=off      (no tocar el agente al arrancar; usa los ids de arriba tal como están)
# Opcionales
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_LLM=claude-haiku-5-5
# Live voice on Eleven Realtime (speech to speech): eleven_realtime_v1_mini (default), eleven_realtime_v1_max, or off
# ELEVENLABS_REALTIME_MODEL=eleven_realtime_v1_mini
# La voz usa por defecto el agente del chat (sigue las reglas y llama a las herramientas). "si" para que la atienda
# el agente de tiempo real (más rápido, pero en las pruebas inventó lugares). En la página: ?voz=tiempo-real.
# VOZ_TIEMPO_REAL=si

# Estilo de viaje (Instagram): clave de Google AI Studio para que lo analice Gemini. Vale GA o GEMINI_API_KEY.
# Sin clave se usan solo palabras clave. Se crea en https://aistudio.google.com/apikey
# GA=
# Optional. Empty = the server finds or creates the realtime voice agent; if the account has no Eleven Realtime, live voice uses the text agent
ELEVENLABS_VOICE_AGENT_ID=

# --- Pagos ---
# The assistant books through a demo flow (reservas.mjs): it asks Wells Fargo account or USDC, and confirms as soon as the user picks one (simulated payment).
# The settings below are only used by the /api/pagos endpoints.
# simulado  = flujo de prueba, no mueve dinero
# cosmospay = Cosmos Pay: cobra en dólares digitales (USDC / USDT) sobre Stellar
# (vacío)   = sin pagos
PAGOS_PROVEEDOR=simulado
# Clave de https://dev.cosmospay.lat  (Dashboard > API Keys > Create, permisos payments read + write)
#   dv_...   = red de prueba (no es dinero real)      prod_... = red real
# Además hay que poner tu cuenta Stellar pública en cosmospay.config.json ("destino")
COSMOSPAY_API_KEY=
# Opcional (avisos instantáneos de pago): lo completa "node registrar-webhook.mjs"
COSMOSPAY_WEBHOOK_SECRET=
# URL_PUBLICA=https://tu-dominio.com

# --- Estilo de viaje (opcional) ---
# Clave de Gemini (https://aistudio.google.com/apikey). Sin clave, estilo-viaje.mjs clasifica solo por palabras clave.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Pasaporte de Jujuy (sellos con QR) ---
# Secret that signs the QR codes. Set it before printing them: without it a random one is used and,
# on a fresh deploy, every printed QR stops working. Any long random text works.
# PASAPORTE_SECRETO=
# Organizer key to see and print the QR codes at /qr.html?clave=... (from this same machine no key is needed)
# PASAPORTE_CLAVE=
# How close (meters) a tourist must be to stamp a stop without the QR. Default 300.
# PASAPORTE_RADIO_M=300

# --- Servidor ---
PUERTO=3000

# --- Solo para un deploy (Railway u otro hosting) ---
# Ahi no se usa este archivo: las mismas variables se cargan en el panel del hosting.
# PORT lo pone el hosting; con PORT definido el servidor escucha en 0.0.0.0.
# URL_PUBLICA=https://tu-dominio.com   (en Railway se detecta sola)
# PAGOS_ARCHIVO=/data/pagos.json       (ruta dentro de un volumen, para no perder las reservas en cada deploy)
# LIMITE_SESIONES=30                   (charlas que puede abrir un visitante cada 10 minutos)
# LIMITE_PAGOS=20                      (pagos que puede crear un visitante cada 10 minutos)

# Copiar este archivo como ".env" y completar. No compartir el .env con nadie.

# --- ElevenLabs (obligatorio) ---
# Clave de API: https://elevenlabs.io/app/settings/api-keys  (con permiso para "ElevenLabs Agents")
ELEVENLABS_API_KEY=
# Lo completa solo "node crear-agente.mjs"
ELEVENLABS_AGENT_ID=
# Opcionales
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_LLM=claude-haiku-5-5
# Live voice on Eleven Realtime (speech to speech): eleven_realtime_v1_mini (default), eleven_realtime_v1_max, or off
# ELEVENLABS_REALTIME_MODEL=eleven_realtime_v1_mini
# Filled in by "node crear-agente.mjs". Empty = live voice uses the text agent
ELEVENLABS_VOICE_AGENT_ID=

# --- Pagos ---
# The assistant books through a demo flow (reservas.mjs): it asks USDC or bank transfer and fakes the payment.
# The settings below are only used by the /api/pagos endpoints.
# simulado  = flujo de prueba, no mueve dinero
# cosmospay = Cosmos Pay: cobra en dólares digitales (USDC / USDT) sobre Stellar
# (vacío)   = sin pagos
PAGOS_PROVEEDOR=simulado
# Clave de https://dev.cosmospay.lat  (Dashboard > API Keys > Create, permisos payments read + write)
#   dv_...   = red de prueba (no es dinero real)      prod_... = red real
# Además hay que poner tu cuenta Stellar pública en cosmospay.config.json ("destino")
COSMOSPAY_API_KEY=
# Opcional (avisos instantáneos de pago): lo completa "node registrar-webhook.mjs"
COSMOSPAY_WEBHOOK_SECRET=
# URL_PUBLICA=https://tu-dominio.com

# --- Servidor ---
PUERTO=3000

# --- Solo para un deploy (Railway u otro hosting) ---
# Ahi no se usa este archivo: las mismas variables se cargan en el panel del hosting.
# PORT lo pone el hosting; con PORT definido el servidor escucha en 0.0.0.0.
# URL_PUBLICA=https://tu-dominio.com   (en Railway se detecta sola)
# PAGOS_ARCHIVO=/data/pagos.json       (ruta dentro de un volumen, para no perder las reservas en cada deploy)
# LIMITE_SESIONES=30                   (charlas que puede abrir un visitante cada 10 minutos)
# LIMITE_PAGOS=20                      (pagos que puede crear un visitante cada 10 minutos)
